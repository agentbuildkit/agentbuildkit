# Default local development path. Copy this file to .env and fill in the key locally.
# Never commit .env.
#
# Provider credentials. The harness does not require either key to import.
# Each agent declares its own provider and model.
# A live OpenAI agent needs OPENAI_API_KEY.
OPENAI_API_KEY=
# A live Anthropic agent needs ANTHROPIC_API_KEY. The default example does not.
# ANTHROPIC_API_KEY=

# Optional Microsoft Foundry settings. Install the extra first:
#   uv sync --extra foundry
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL=

# Application settings loaded with the APP_ prefix.
# Console export stays off unless this is set to true. Sensitive payloads stay off.
APP_SERVICE_NAME=agentbuildkit
APP_ENVIRONMENT=local
APP_ENABLE_CONSOLE_EXPORTERS=false
# APP_OTLP_ENDPOINT=
# Directory for durable workflow state. The container image sets this to /data.
# APP_STATE_DIRECTORY=

# GitHub App credentials for governed repository operations.
# The private key is a PEM string. It never belongs in a prompt or a log.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY=

# Cursor Cloud Agent API key. It stays on the authorization header.
# CURSOR_API_KEY=
